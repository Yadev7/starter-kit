generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Put this back!
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  hash      String   
  hashedRt  String?  
  
  firstName String?
  lastName  String?
  role      Role     @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  USER
  ADMIN
  PROVIDER
}